async\"/><div class=\"menu-photo-caption\"><span>MỘC 83</span><p>Drinks &amp; desserts</p></div></div><div class=\"dish-list\"><article class=\"dish\"><div class=\"dish-heading\"><h3>Passionfruit</h3><span class=\"price\">6,90<!-- --> €</span></div><p>Fresh lime, cane sugar, passion fruit nectar and soda.</p><small class=\"dish-detail\">Homemade</small></article><article class=\"dish\"><div class=\"dish-heading\"><h3>Vietnamese Iced Coffee</h3><span class=\"price\">5,50<!-- --> €</span></div><p>Vietnamese iced coffee with sweetened condensed milk and crushed ice.</p><small class=\"dish-detail\">A Vietnamese classic</small></article><article class=\"dish\"><div class=\"dish-heading\"><h3>Mochi Eis</h3><span class=\"price\">6,50<!-- --> €</span></div><p>Japanese rice cakes filled with creamy ice cream.</p><small class=\"dish-detail\">6 pieces</small></article><article class=\"dish\"><div class=\"dish-heading\"><h3>Bánh Rán</h3><span class=\"price\">6,00<!-- --> €</span></div><p>Crispy sesame balls with a sweet bean filling.</p><small class=\"dish-detail\">4 pieces</small></article><button class=\"underlined-link\">View the full menu<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z\"></path></svg></button></div></div>"]}